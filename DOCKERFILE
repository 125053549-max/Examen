# Usamos una imagen oficial y ligera de Python
FROM python:3.10-slim

# Establecemos el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiamos el archivo de dependencias primero para aprovechar la caché de Docker
COPY requirements.txt .

# Instalamos las dependencias del proyecto
RUN pip install --no-cache-dir -r requirements.txt

# Copiamos el resto del código fuente del proyecto
COPY . .

# Exponemos el puerto 5001 en el contenedor
EXPOSE 5001

# Comando por defecto para ejecutar la aplicación (ajusta 'app.py' si tu archivo principal tiene otro nombre)
CMD ["python", "app.py"]